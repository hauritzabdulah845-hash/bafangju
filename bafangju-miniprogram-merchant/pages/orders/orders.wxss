/* 订单履约（商家端） */
.mo { min-height: 100vh; background: #F6F6F6; padding-bottom: 40rpx; }

.tabs { display: flex; background: #FFFFFF; padding: 0 8rpx; position: sticky; top: 0; z-index: 5; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 30rpx; color: #666666; position: relative; }
.tab.on { color: #8F1F26; font-weight: 600; }
.tab.on::after {
  content: ''; position: absolute; left: 50%; bottom: 8rpx; transform: translateX(-50%);
  width: 44rpx; height: 6rpx; border-radius: 3rpx; background: linear-gradient(90deg, #C9525A, #B02A30);
}

.list { padding: 20rpx 24rpx 0; }
.card { margin-bottom: 20rpx; }

.btn-sm { margin-top: 20rpx; padding: 16rpx 0; font-size: 28rpx; border-radius: 12rpx; }
.btn-plain.btn-sm { margin-top: 20rpx; padding: 15rpx 0; font-size: 28rpx; border-radius: 12rpx; }
.row.gap { gap: 20rpx; }
.row.gap .btn, .row.gap .btn-plain { flex: 1; }

.form { margin-top: 20rpx; padding: 20rpx; background: #FAFAFA; border-radius: 12rpx; }
.picker { font-size: 28rpx; color: #333333; padding: 16rpx 20rpx; background: #FFFFFF; border-radius: 10rpx; margin-bottom: 14rpx; }
.ipt { background: #FFFFFF; border-radius: 10rpx; padding: 18rpx 20rpx; font-size: 28rpx; margin-bottom: 6rpx; }

.warn { color: #996300; }
.empty { text-align: center; color: #666666; font-size: 28rpx; padding: 80rpx 0; }
