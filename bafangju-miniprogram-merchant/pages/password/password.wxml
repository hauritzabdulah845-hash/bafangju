<!-- 商家端 · 修改登录密码 -->
<view class="pwd-page">
  <view class="card">
    <view class="t1">修改登录密码</view>
    <view class="t-weak" style="margin-top:8rpx">首次登录使用初始密码时，建议立即修改为个人密码。</view>
    <input class="ipt" style="margin-top:24rpx" password placeholder="原密码" value="{{oldPassword}}" data-k="oldPassword" bindinput="onInput" />
    <input class="ipt" style="margin-top:14rpx" password placeholder="新密码（至少 8 位）" value="{{newPassword}}" data-k="newPassword" bindinput="onInput" />
    <input class="ipt" style="margin-top:14rpx" password placeholder="确认新密码" value="{{confirmPassword}}" data-k="confirmPassword" bindinput="onInput" />
    <view class="btn" style="margin-top:28rpx" bindtap="submit">{{submitting ? '提交中…' : '确认修改'}}</view>
    <view class="t-weak" style="margin-top:16rpx">修改成功后当前登录会失效，请用新密码重新登录。</view>
  </view>
</view>
