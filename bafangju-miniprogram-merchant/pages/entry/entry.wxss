.notice { background: #FAF0F0; color: #666666; font-size: 28rpx; padding: 16rpx 24rpx; border-radius: 12rpx; margin: 20rpx; line-height: 1.6; }
.ipt { border: 1rpx solid #e5e9f0; border-radius: 12rpx; padding: 18rpx 24rpx; margin: 16rpx 0; font-size: 30rpx; }
.label { font-size: 28rpx; color: #666; margin: 12rpx 0 8rpx; }
.cats { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cat { border: 1rpx solid #d7dee8; border-radius: 30rpx; padding: 8rpx 24rpx; font-size: 28rpx; color: #555; }
.cat.on { background: #B02A30; color: #fff; border-color: #B02A30; }
.img-box { width: 320rpx; height: 220rpx; border: 2rpx dashed #c9d4e2; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; overflow: hidden; }
.img-box .img { width: 100%; height: 100%; }
.plus { color: #98a6b8; font-size: 30rpx; }
.agree { display: flex; align-items: flex-start; gap: 12rpx; padding: 8rpx 24rpx; font-size: 28rpx; color: #555; margin-bottom: 20rpx; }
.check { width: 36rpx; height: 36rpx; line-height: 34rpx; text-align: center; border: 1rpx solid #c9d4e2; border-radius: 6rpx; color: #fff; flex-shrink: 0; }
.check.on { background: #B02A30; border-color: #B02A30; }
.agree .link { color: #B02A30; }

/* 门店位置选点行 */
.loc-pick {
  border: 1rpx solid #e5e9f0; border-radius: 12rpx; padding: 20rpx 24rpx; margin: 8rpx 0 4rpx;
  display: flex; align-items: center; justify-content: space-between; background: #FFFFFF;
}
.loc-pick.picked { border-color: #B02A30; background: #FAF0F0; }
.lp-left { display: flex; align-items: center; flex: 1; }
/* 选点图标：品牌红圆底 + 共享白色线性 pin（原 emoji 📍 跨平台渲染不一致） */
.lp-icon {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #C2410C; margin-right: 16rpx; flex-shrink: 0;
}
.lp-text { flex: 1; }
.lp-addr { font-size: 30rpx; color: #333333; line-height: 1.4; }
.lp-hint { font-size: 28rpx; color: #666666; margin-top: 6rpx; }
.lp-hint-tip { color: #999999; }
.lp-go { font-size: 28rpx; color: #8F1F26; flex-shrink: 0; margin-left: 16rpx; }

/* 已入驻商家 · 只读资料视图 */
.info-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid #EEEEEE; font-size: 28rpx; }
.info-row:last-child { border-bottom: none; }
.info-key { color: #999999; flex-shrink: 0; }
.info-val { color: #3F3E3E; text-align: right; flex: 1; word-break: break-all; }
.info-val.muted { color: #999999; }
.sec-note { font-size: 26rpx; color: #999999; line-height: 1.7; margin-top: 16rpx; }

/* ---------- 申请进度自助查询 ---------- */
.query-toggle {
  text-align: center; color: #B02A30; font-size: 26rpx;
  padding: 20rpx 0 8rpx; margin-bottom: 12rpx;
}
.query-card { padding-bottom: 8rpx; }
.query-card .ipt { margin: 12rpx 0; }
.query-card .btn-plain { margin: 16rpx 0 0; text-align: center; }
.query-result { border-radius: 12rpx; padding: 20rpx 24rpx; margin-top: 20rpx; background: #F7F8FA; }
.query-result .qr-status { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.query-result .qr-tip { font-size: 24rpx; color: #999999; line-height: 1.7; margin-top: 4rpx; }
.query-result.q-wait .qr-status { color: #C2410C; }
.query-result.q-ok .qr-status { color: #2E7D32; }
.query-result.q-bad .qr-status { color: #B02A30; }
