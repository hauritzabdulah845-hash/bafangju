/* 广告位（商家端，V3.7） */
.ad-page { padding-bottom: 40rpx; }
.ad-row { padding: 16rpx 0; border-bottom: 1rpx solid #F2F3F7; }
.ad-row:last-child { border-bottom: 0; }
.ad-name { font-weight: 600; }

/* 广告位选择 */
.slot {
  margin-top: 14rpx; padding: 20rpx; border-radius: 14rpx;
  background: #FAFAFA; border: 2rpx solid transparent;
}
.slot.on { border-color: #B02A30; background: #FFF5F4; }
.price { color: #8F1F26; font-size: 30rpx; font-weight: 700; }

/* 素材 */
.ipt {
  background: #FAFAFA; border-radius: 10rpx; padding: 18rpx 20rpx;
  font-size: 28rpx; margin-top: 14rpx;
}
.ad-preview { width: 100%; height: 200rpx; border-radius: 12rpx; margin-top: 14rpx; background: #F2F2F2; }

.btn-sm { padding: 14rpx 28rpx; font-size: 28rpx; border-radius: 12rpx; }
.row.gap { gap: 16rpx; }
.empty { text-align: center; color: #666666; font-size: 28rpx; padding: 60rpx 0; }
