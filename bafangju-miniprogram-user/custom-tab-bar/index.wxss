/* 自定义底部导航 · 适老版（系统 tabBar 字号固定 10px 不可调，故自建）
   文字 26rpx(13px) / 图标 52rpx / 高度 116rpx，选中变红加粗 */
.tab-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 999;
  display: flex; align-items: flex-start;
  background: #FFFFFF;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.tab-bar-border { position: absolute; left: 0; top: 0; width: 100%; height: 1rpx; background: #EEEEEE; }
.tab-bar-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding-top: 14rpx; height: 116rpx; box-sizing: border-box;
}
.tb-icon {
  width: 52rpx; height: 52rpx; background-repeat: no-repeat; background-position: center; background-size: contain;
}
.tb-text {
  font-size: 24rpx; line-height: 34rpx; margin-top: 6rpx;
  color: #666666; font-weight: 400;
}
.tb-text.on { color: #8F1F26; font-weight: 600; }
.tb-icon.on { transform: scale(1.06); }
.tb-home { background-image: url("data:image/svg+xml;base64,"); }
.tb-home.on { background-image: url("data:image/svg+xml;base64,"); }
.tb-order { background-image: url("data:image/svg+xml;base64,"); }
.tb-order.on { background-image: url("data:image/svg+xml;base64,"); }
.tb-ladder { background-image: url("data:image/svg+xml;base64,"); }
.tb-ladder.on { background-image: url("data:image/svg+xml;base64,"); }
.tb-me { background-image: url("data:image/svg+xml;base64,"); }
.tb-me.on { background-image: url("data:image/svg+xml;base64,"); }
.tb-ad { background-image: url("data:image/svg+xml;base64,"); }
.tb-ad.on { background-image: url("data:image/svg+xml;base64,"); }
