.row { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #f2f2f2; font-size: 30rpx; }
.notice { background: #FFF7E6; color: #996300; font-size: 28rpx; padding: 16rpx 24rpx; border-radius: 12rpx; margin: 20rpx; line-height: 1.6; }

/* 等级徽标：与右侧说明同一行的胶囊标签 */
.level-tag {
  display: inline-block; font-size: 24rpx; color: #8F1F26;
  background: #FAF0F0; border-radius: 8rpx; padding: 4rpx 14rpx;
}
