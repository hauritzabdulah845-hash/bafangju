.aw {
  position: fixed; inset: 0; background: #141210;
  display: flex; align-items: center; justify-content: center;
}
.aw-video { width: 100%; height: 100%; }
.aw-ad-tag {
  position: absolute; left: 24rpx; top: 70rpx;
  font-size: 20rpx; color: rgba(255, 255, 255, .9);
  border: 1rpx solid rgba(255, 255, 255, .5); border-radius: 8rpx;
  padding: 4rpx 14rpx; letter-spacing: 4rpx;
}
.aw-progress {
  position: absolute; left: 40rpx; right: 40rpx; bottom: 120rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.aw-line { flex: 1; height: 8rpx; border-radius: 4rpx; background: rgba(255, 255, 255, .25); overflow: hidden; }
.aw-fill { height: 100%; background: linear-gradient(90deg, #C2410C, #E08A3C); border-radius: 4rpx; }
.aw-pct { font-size: 22rpx; color: rgba(255, 255, 255, .85); }
.aw-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30rpx; }
.aw-loading { color: rgba(255, 255, 255, .7); font-size: 28rpx; }
.aw-err { color: rgba(255, 255, 255, .85); font-size: 28rpx; text-align: center; padding: 0 60rpx; line-height: 1.7; }
.aw-mask { position: absolute; inset: 0; background: rgba(12, 8, 6, .6); display: flex; align-items: center; justify-content: center; }
.aw-reward {
  width: 560rpx; background: #FFFDF8; border-radius: 40rpx; padding: 50rpx 44rpx 40rpx;
  text-align: center; box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, .4);
}
.aw-medal {
  width: 130rpx; height: 130rpx; margin: 0 auto 20rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #F3DCA8, #C89B5A);
  box-shadow: 0 16rpx 34rpx rgba(200, 155, 90, .45);
  display: flex; align-items: center; justify-content: center;
  font-size: 54rpx; font-weight: 800; color: #7a4a12;
}
.aw-rt { font-size: 28rpx; color: #8a5a1a; letter-spacing: 2rpx; }
.aw-amt { font-size: 72rpx; font-weight: 800; color: #C2410C; margin: 10rpx 0 6rpx; }
.aw-sub { font-size: 22rpx; color: #A09488; margin-bottom: 34rpx; }
.aw-btn {
  display: block; background: linear-gradient(120deg, #C2410C, #A9330B); color: #fff;
  border-radius: 44rpx; padding: 22rpx 0; font-size: 30rpx; font-weight: 700;
  letter-spacing: 3rpx; box-shadow: 0 12rpx 28rpx rgba(194, 65, 12, .35); margin-top: 20rpx;
}
.aw-btn-ghost { background: #fff; color: #C2410C; border: 2rpx solid #EAD3C8; box-shadow: none; }
.aw-btn-gold {
  background: linear-gradient(120deg, #E8C982, #C89B5A); color: #5a3a10;
  border-radius: 40rpx; padding: 18rpx 60rpx; font-size: 28rpx; font-weight: 700;
  display: inline-block; box-shadow: none;
}
