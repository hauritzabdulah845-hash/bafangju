<view class="tip" wx:if="{{selectMode}}">点击地址即可选用 · 返回继续下单</view>

<view class="empty muted" wx:if="{{!list.length}}">还没有收货地址，点击下方按钮添加</view>

<view class="addr" wx:for="{{list}}" wx:key="id" data-idx="{{index}}" bindtap="pick">
  <view class="a-main">
    <view class="a-line1">
      <text class="a-name">{{item.name}}</text>
      <text class="a-phone">{{item.phone}}</text>
      <text class="a-def" wx:if="{{item.isDefault}}">默认</text>
    </view>
    <view class="a-detail">{{item.region}} {{item.address}}</view>
  </view>
  <view class="a-ops" wx:if="{{!selectMode}}">
    <text class="a-op" data-idx="{{index}}" catchtap="setDefault" wx:if="{{!item.isDefault}}">设默认</text>
    <text class="a-op danger" data-idx="{{index}}" catchtap="remove">删除</text>
  </view>
  <view class="a-check" wx:else>选择</view>
</view>

<view class="btn-primary add-btn" bindtap="openForm">+ 新增收货地址</view>

<!-- 新增地址表单（弹层） -->
<view class="mask" wx:if="{{showForm}}" catchtap="closeForm">
  <view class="form-card" catchtap="noop">
    <view class="form-title">
      <text>新增收货地址</text>
      <text class="import-link" bindtap="importWxAddress">导入微信地址</text>
    </view>
    <view class="f-row"><text class="f-label">收货人</text><input placeholder="姓名" value="{{form.name}}" data-k="name" bindinput="onInput" /></view>
    <view class="f-row"><text class="f-label">手机号</text><input type="number" maxlength="11" placeholder="11 位手机号" value="{{form.phone}}" data-k="phone" bindinput="onInput" /></view>
    <view class="f-row"><text class="f-label">所在地区</text><picker mode="region" bindchange="onRegion"><view class="picker">{{region[0]}} {{region[1]}} {{region[2]}}</view></picker></view>
    <view class="f-row"><text class="f-label">详细地址</text><input placeholder="街道、门牌号、楼栋房号" value="{{form.address}}" data-k="address" bindinput="onInput" /></view>
    <view class="f-row"><text class="f-label">设为默认</text><switch checked="{{form.isDefault}}" bindchange="toggleDefault" color="#B02A30" /></view>
    <view class="btn-primary" bindtap="submit">保存地址</view>
  </view>
</view>
