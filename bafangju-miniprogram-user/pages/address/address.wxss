.tip { background: #FAF0F0; color: #8F1F26; font-size: 28rpx; padding: 16rpx 28rpx; }
.empty { text-align: center; padding: 80rpx 0 40rpx; }
.addr { background: #fff; margin: 20rpx 24rpx; border-radius: 20rpx; border: 1rpx solid #EEEEEE; padding: 26rpx 28rpx; }
.a-main { display: flex; flex-direction: column; min-width: 0; }
.a-line1 { display: flex; align-items: center; }
.a-name { font-size: 30rpx; font-weight: 400; }
.a-phone { font-size: 28rpx; color: #999999; margin-left: 16rpx; }
.a-def { font-size: 24rpx; color: #8F1F26; border: 1rpx solid #B02A30; border-radius: 6rpx; padding: 0 10rpx; margin-left: 16rpx; }
.a-detail { font-size: 28rpx; color: #666666; margin-top: 10rpx; line-height: 1.6; }
.a-ops { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.a-op { font-size: 28rpx; color: #999999; margin-left: 32rpx; }
.a-op.danger { color: #C22A2F; }
.a-check { margin-top: 12rpx; text-align: right; color: #8F1F26; font-size: 28rpx; }
.add-btn { margin: 32rpx 24rpx; }
.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,.45); z-index: 9; display: flex; align-items: flex-end; }
.form-card { background: #fff; width: 100%; border-radius: 32rpx 32rpx 0 0; padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); }
.form-title { display: flex; justify-content: space-between; align-items: center; font-size: 32rpx; font-weight: 400; margin-bottom: 24rpx; }
.import-link { font-size: 28rpx; color: #8F1F26; font-weight: 500; padding: 8rpx 0; }
.f-row { display: flex; align-items: center; border-bottom: 1rpx solid #EEEEEE; padding: 24rpx 0; }
.f-label { width: 160rpx; font-size: 28rpx; color: #666666; }
.f-row input, .picker { flex: 1; font-size: 30rpx; }
