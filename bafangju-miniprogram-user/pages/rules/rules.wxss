/* 规则说明 · 拼多多配色（规范板推断） */

.rules-head {
  background: #B02A30;
  padding: 28rpx 24rpx 36rpx;
  border-radius: 0 0 24rpx 24rpx;
}
.rules-head .t-white { font-size: 34rpx; }
.head-sub { font-size: 28rpx; color: rgba(255, 255, 255, 0.82); margin-top: 8rpx; }

/* 条款卡流 */
.rule-list { padding: 24rpx; }
.rule-card { margin: 0 0 20rpx; }
.rule-no {
  width: 44rpx; height: 44rpx; border-radius: 50%; flex-shrink: 0; margin-right: 20rpx;
  background: linear-gradient(180deg, #C9525A, #B02A30);
  color: #FFFFFF; font-size: 28rpx; font-weight: 600; text-align: center; line-height: 44rpx;
}
.rule-text { flex: 1; font-size: 28rpx; color: #3F3E3E; line-height: 1.8; }
