/* 消息中心 · 拼多多配色（规范板推断） */

.msgs-head {
  background: #B02A30;
  padding: 28rpx 24rpx 36rpx;
  border-radius: 0 0 24rpx 24rpx;
}
.msgs-head .t-white { font-size: 34rpx; }
.head-action {
  font-size: 28rpx; color: #FFFFFF;
  background: rgba(255, 255, 255, 0.16); border-radius: 28rpx; padding: 8rpx 20rpx;
}
.head-sub { font-size: 28rpx; color: rgba(255, 255, 255, 0.82); margin-top: 8rpx; }

/* 消息卡流 */
.msg-list { padding: 24rpx; }
.msg-card { margin: 0 0 20rpx; display: flex; align-items: flex-start; }
.msg-card.unread { background: #FFFCFA; }
.msg-icon {
  width: 64rpx; height: 64rpx; border-radius: 16rpx; flex-shrink: 0; margin-right: 20rpx;
  background: #FAF0F0 url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C2410C%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M7%2013a9%209%200%200%201%2018%200v6l2.5%204.5H4.5L7%2019z%22%2F%3E%3Cpath%20d%3D%22M13%2026.5a3%203%200%200%200%206%200%22%20stroke%3D%22%23C89B5A%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E") no-repeat center / 36rpx;
}
.msg-body { flex: 1; }
.msg-title { flex: 1; }
.msg-text { margin-top: 8rpx; line-height: 1.6; }
.msg-time { margin-top: 12rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #B02A30; flex-shrink: 0; margin-top: 10rpx; }

/* 空态 */
.empty { padding: 120rpx 0; display: flex; flex-direction: column; align-items: center; }
.empty-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%; margin-bottom: 24rpx;
  background: #FFFFFF url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C9C2B8%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2216%22%20cy%3D%2216%22%20r%3D%2211%22%2F%3E%3Cpath%20d%3D%22M11%2016h.01M16%2016h.01M21%2016h.01%22%20stroke-width%3D%222.8%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E") no-repeat center / 56rpx;
}
