/* 自定义 tabBar 为 fixed 定位，不自动占位，需自行留出底部高度（116rpx + 安全区） */
page { padding-bottom: calc(124rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 我的订单 · 拼多多配色重设计（对应 Ardot 屏幕-我的订单 5:1）
   红色头部 Tab 行 + 白卡订单流；卡片 r12、密度优先 */

/* 红色头部：原生导航栏之下 */
.orders-head {
  background: #B02A30;
  padding: 0 24rpx;
}
.tabs { display: flex; height: 88rpx; align-items: flex-end; }
.tab {
  flex: 1; text-align: center;
  font-size: 28rpx; color: rgba(255, 255, 255, 0.72);
  padding-bottom: 18rpx; position: relative;
}
.tab.active { color: #FFFFFF; font-weight: 600; }
.tab-bar {
  width: 32rpx; height: 4rpx; border-radius: 2rpx;
  background: #FFFFFF; margin: 8rpx auto 0;
}

/* 阶梯规则入口条：浅橙底，与页面暖调一致 */
.rules-bar {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #FFF7F0;
  border: 1rpx solid #FFE4CC;
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: space-between;
  font-size: 24rpx; color: #996300;
}
.rules-bar .arrow { color: #B02A30; font-weight: 600; }

/* 订单卡流 */
.order-list { padding: 20rpx 24rpx 40rpx; }
.order-card { margin: 0 0 20rpx; padding: 24rpx; border-radius: 24rpx; }
.order-card:last-child { margin-bottom: 0; }

/* 店铺行 */
.shop-row { gap: 10rpx; }
.shop-icon {
  width: 32rpx; height: 32rpx; border-radius: 8rpx; flex-shrink: 0;
  background: #FAF0F0 url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C2410C%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M6%2012l2-6h16l2%206%22%2F%3E%3Cpath%20d%3D%22M7%2012v13a1%201%200%200%200%201%201h16a1%201%200%200%200%201-1V12%22%2F%3E%3Cpath%20d%3D%22M6%2012h20%22%20stroke%3D%22%23C89B5A%22%2F%3E%3Cpath%20d%3D%22M13%2026v-6a3%203%200%200%201%206%200v6%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E") no-repeat center / 20rpx;
}
.status { font-size: 28rpx; }
.st-accent { color: #8F1F26; }
.st-free { color: #996300; font-weight: 600; }

/* 商品行 */
.goods-row { margin-top: 20rpx; align-items: stretch; }
.goods-img {
  width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0;
  background: #F7F7F7;
}
.goods-img-fallback {
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; color: #6B6B6B; font-weight: 600;
}
.goods-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.goods-name { line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.goods-price { text-align: right; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; }

/* 操作行 */
.actions { margin-top: 20rpx; justify-content: space-between; }
.order-time { flex: 1; }
.actions-row { flex-shrink: 0; }
.actions-row > view + view { margin-left: 16rpx; }

/* 履约信息（V3.5）：核销码 / 快递 / 售后状态 */
.goods-info { justify-content: flex-start; }
.goods-info > view + view { margin-top: 6rpx; }
.code-line { color: #8F1F26; text-decoration: underline; }
.aftersale-line { color: #996300; }

/* 空态 */
.empty { padding: 120rpx 0; display: flex; flex-direction: column; align-items: center; }
.empty-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%; margin-bottom: 24rpx;
  background: #FFFFFF url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C9C2B8%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2216%22%20cy%3D%2216%22%20r%3D%2211%22%2F%3E%3Cpath%20d%3D%22M11%2016h.01M16%2016h.01M21%2016h.01%22%20stroke-width%3D%222.8%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E") no-repeat center / 56rpx;
}
