/* 商品详情 · 拼多多配色重设计（对应 Ardot 屏幕-商品详情） */

.pdp { padding-bottom: 160rpx; }

/* 主图：通栏大图 */
.p-hero-img { width: 100%; height: 560rpx; display: block; background: #F7F7F7; }

/* 详情页广告位（V3.7） */
.ad-strip { margin: 20rpx 24rpx 0; height: 160rpx; border-radius: 16rpx; overflow: hidden; background: #FFF7E6; }
.ad-strip-img { width: 100%; height: 100%; display: block; }
.ad-strip-text {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #ffd08a, #b7791f); color: #5C3D00;
  font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx;
}

/* 价格卡 */
.price-card { margin-top: -24rpx; border-radius: 24rpx 24rpx 0 0; position: relative; z-index: 1; }
.p-name { font-size: 30rpx; font-weight: 600; color: #3F3E3E; line-height: 1.5; margin-top: 16rpx; }
.p-tags { margin-top: 14rpx; flex-wrap: wrap; }

/* 商家/履约行 */
.seller-avatar {
  width: 64rpx; height: 64rpx; border-radius: 32rpx;
  background: linear-gradient(135deg, #C9525A, #B02A30);
  color: #FFFFFF; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-right: 16rpx; flex-shrink: 0;
}
.seller-info { flex: 1; }
.service-row { justify-content: space-between; }
.service-link { flex-shrink: 0; }
/* 履约说明卡：与相邻 .card 保持同节奏间距 */
.seller-card { margin-top: 24rpx; }

/* 收货信息 */
.addr-row { display: flex; justify-content: space-between; align-items: center; }
.addr-line1 { font-size: 28rpx; font-weight: 500; color: #3F3E3E; }
.addr-detail { font-size: 28rpx; color: #666666; margin-top: 6rpx; line-height: 1.6; }
.addr-arrow { font-size: 42rpx; color: #8C8C8C; } /* 非文本元素，WCAG 1.4.11 要求 ≥3:1（#8C8C8C = 3.36:1） */

.agree-text { font-size: 28rpx; color: #666666; line-height: 1.6; flex: 1; }

/* 阶梯卡标题：主标题不换行，说明降为副标题一行小字（避免长标题折行挤压右侧操作） */
.ladder-title { white-space: nowrap; }
.ladder-note { font-size: 24rpx; color: #666666; margin-top: 8rpx; line-height: 1.4; }

/* 底部操作栏：固定 */
.action-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}
.ab-btn {
  flex: 1; text-align: center; font-size: 30rpx; font-weight: 500;
  border-radius: 44rpx; padding: 20rpx 0;
}
.ab-outline { background: #FFFFFF; color: #8F1F26; border: 1rpx solid #B02A30; }
.ab-primary {
  background: linear-gradient(90deg, #C9525A, #B02A30); color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(176, 42, 48, 0.22);
}
.ab-primary.disabled { background: #F5CFCB; box-shadow: none; }
.ab-gold { background: linear-gradient(90deg, #FFC940, #B7791F); color: #5C3D00; font-weight: 600; }
