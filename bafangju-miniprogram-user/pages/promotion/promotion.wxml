<!-- 推广返利 · 拼多多配色重设计（对应 Ardot 屏幕-推广返利 5:197）
     结构：渐变头部（累计收益 + chips）→ 邀请卡（二维码/邀请码/复制）→ 收益卡 → 团队卡 → 合规说明
     数据：/api/user/promotion/profile、/api/user/promotion/earnings、/api/user/promotion/qrcode -->
<view class="promo">

  <!-- 渐变带：只承载图标，文字移到下方上浮白卡 -->
  <view class="grad-header">
    <view class="hero-icon"><view class="hi hi-megaphone"></view></view>
  </view>

  <!-- 上浮状态卡：累计推广收益 + chips -->
  <view class="card hero-card" bindtap="goWithdraw" hover-class="none">
    <view class="gh-label">累计推广收益（元）</view>
    <view style="margin-top:8rpx">
      <text class="gh-num">{{profile.earnedYuan || '0.00'}}</text>
    </view>
    <view style="margin-top:16rpx;display:flex;flex-wrap:wrap;justify-content:center">
      <text class="gh-chip">已邀请 {{profile.directCount || 0}} 人</text>
      <text class="gh-chip">活跃 {{profile.activeDirectCount || 0}} 人</text>
      <text class="gh-chip">待到账 ¥{{profile.frozenYuan || '0.00'}}</text>
    </view>
  </view>

  <view style="padding:0 24rpx 40rpx;margin-top:0">

    <!-- 邀请卡 -->
    <view class="card" style="margin-top:0">
      <view class="row-between">
        <view class="t1">我的邀请码</view>
        <view class="t3 t-accent" bindtap="copyCode">复制 ›</view>
      </view>

      <!-- 小程序码：配置 AppID/Secret 后由服务端生成真实码（scene=邀请码，扫码进首页自动绑定） -->
      <view class="qr-box" style="margin-top:24rpx">
        <block wx:if="{{qrLoading}}">
          <view class="qr qr-loading"><text class="qr-load-text">生成中…</text></view>
        </block>
        <block wx:elif="{{qrcode && !qrcode.devMode}}">
          <image class="qr" src="{{qrcode.fullUrl || ('data:image/png;base64,' + qrcode.base64)}}"
                 mode="widthFix" show-menu-by-longpress="true" bindtap="previewQr" />
        </block>
        <block wx:else>
          <view class="qr qr-dev">
            <text class="qr-dev-num">{{profile.inviteCode || '—'}}</text>
            <text class="qr-dev-tip">小程序码占位</text>
          </view>
        </block>
        <view class="qr-tip" wx:if="{{qrcode && qrcode.devMode && qrcode.reason}}">{{qrcode.reason}}</view>
      </view>

      <!-- 邀请码：小程序码的兜底（好友也可在首页手动填码） -->
      <view class="invite-code-row" style="margin-top:20rpx">
        <text class="t-weak">邀请码</text>
        <text class="invite-code">{{profile.inviteCode || '加载中…'}}</text>
      </view>
      <view class="qr-actions">
        <view class="btn-outline btn-sm btn-block" bindtap="saveQr">保存小程序码</view>
        <button class="share-btn" open-type="share">分享给好友</button>
      </view>
      <view class="notice" style="margin:16rpx 0 0">好友扫码进入首页即自动绑定邀请关系（一次性、不可更改）；也可分享页面给好友。</view>
    </view>

    <!-- 收益卡 -->
    <view class="card">
      <view class="row-between">
        <view class="t1">推广收益</view>
        <view class="t3 t-accent" bindtap="goWithdraw">{{withdrawEnabled ? '去提现 ›' : '提现未开放'}}</view>
      </view>
      <view class="stat-row">
        <view class="stat">
          <view class="price-row"><text class="price-symbol">¥</text><text class="price-num sm">{{profile.earnedYuan || '0.00'}}</text></view>
          <view class="t-weak">累计到账</view>
        </view>
        <view class="stat">
          <view class="price-row"><text class="price-symbol">¥</text><text class="price-num sm">{{profile.frozenYuan || '0.00'}}</text></view>
          <view class="t-weak">待到账（过退货期）</view>
        </view>
        <view class="stat">
          <view class="price-row"><text class="price-symbol">¥</text><text class="price-num sm">{{withdrawYuan}}</text></view>
          <view class="t-weak">可提现余额</view>
        </view>
      </view>
      <view class="notice" style="margin:20rpx 0 0">推广收益是平台给的邀请奖励：你直接邀请的好友下单，过退货期后你拿 70%，和货款完全分开；间接邀请的奖励默认关闭。</view>
    </view>

    <!-- 团队卡 -->
    <view class="card">
      <view class="row-between">
        <view class="t1">团队概览</view>
        <view class="t3 t-accent" bindtap="goTeam">查看我的团队 ›</view>
      </view>
      <view class="stat-row" style="margin-top:12rpx">
        <view class="stat">
          <view class="stat-num">{{profile.directCount || 0}}</view>
          <view class="t-weak">已邀请好友（人）</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{profile.activeDirectCount || 0}}</view>
          <view class="t-weak">近 30 天活跃（人）</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{earnings.length}}</view>
          <view class="t-weak">收益记录（条）</view>
        </view>
      </view>
      <view class="divider"></view>
      <view class="row-between" bindtap="goTeam">
        <view class="t3">邀请关系绑定后不可更改，明细仅汇总展示</view>
        <view class="t3 t-accent">›</view>
      </view>
    </view>

    <!-- 收益明细 -->
    <view class="card" wx:if="{{earnings.length}}">
      <view class="t1">收益明细</view>
      <view class="row" wx:for="{{earnings}}" wx:key="index" style="padding:14rpx 0;font-size: 24rpx">
        <text class="t2">{{item.timeText}}</text>
        <view class="row">
          <text class="t2 t-bold t-accent">¥{{item.yuan}}</text>
          <text class="t-weak" style="margin-left:12rpx">{{item.text}}</text>
        </view>
      </view>
    </view>

    <view class="notice">{{ct['promotion.note'] || '推广收益为平台营销补贴，不构成投资回报承诺；邀请关系一经绑定不可变更。'}}</view>
  </view>
</view>
