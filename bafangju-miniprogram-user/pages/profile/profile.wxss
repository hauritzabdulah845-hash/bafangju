/* 自定义 tabBar 为 fixed 定位，不自动占位，需自行留出底部高度（116rpx + 安全区） */
page { padding-bottom: calc(124rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 我的 · 拼多多配色（规范板推断） */

/* 渐变带内的图标 */
.grad-header .hero-icon {
  width: 88rpx; height: 88rpx; line-height: 88rpx; margin: 0 auto;
  border-radius: 50%; background: rgba(255,255,255,.22);
  font-size: 48rpx; color: #FFFFFF;
}

/* 上浮状态卡内的头像（缩小到 72rpx，白底浅品牌色描边） */
.hero-card .avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0;
  border: 4rpx solid #FAF0F0;
  background: #FAF0F0 url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C2410C%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2216%22%20cy%3D%2211%22%20r%3D%224.5%22%2F%3E%3Cpath%20d%3D%22M8%2027c0-5%203.6-8%208-8s8%203%208%208%22%2F%3E%3Cpath%20d%3D%22M13%2019.8c1%20.8%202%201.2%203%201.2s2-.4%203-1.2%22%20stroke%3D%22%23C89B5A%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E") no-repeat center / 40rpx;
}

/* 头像按钮：清掉 button 默认外观（边框/内边距/背景），只保留圆形头像 */
.hero-card .avatar-btn {
  width: 72rpx; height: 72rpx; padding: 0; margin: 0; flex-shrink: 0;
  line-height: normal; border-radius: 50%; overflow: hidden;
  background: transparent; border: none;
}
.hero-card .avatar-btn::after { border: none; }
.hero-card .avatar-img {
  width: 72rpx; height: 72rpx; border-radius: 50%; display: block;
  border: 4rpx solid #FAF0F0; box-sizing: border-box;
}

/* 上浮状态卡内的消息入口（白底浅灰，与页面卡片一致） */
.hero-card .head-notice {
  width: 56rpx; height: 56rpx; border-radius: 50%; position: relative;
  background: #F5F5F5 url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C2410C%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M7%2013a9%209%200%200%201%2018%200v6l2.5%204.5H4.5L7%2019z%22%2F%3E%3Cpath%20d%3D%22M13%2026.5a3%203%200%200%200%206%200%22%20stroke%3D%22%23C89B5A%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E") no-repeat center / 32rpx;
}
.hero-card .msg-dot { position: absolute; top: 8rpx; right: 8rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: #B02A30; }

/* 订单宫格 */
.order-grid { display: flex; margin-top: 24rpx; }
.grid-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.gi-icon {
  width: 72rpx; height: 72rpx; border-radius: 20rpx; margin-bottom: 12rpx; position: relative;
  background: #FAF0F0 no-repeat center / 40rpx;
}
.gi-pay { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C2410C%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%224%22%20y%3D%229%22%20width%3D%2224%22%20height%3D%2215%22%20rx%3D%223%22%2F%3E%3Cpath%20d%3D%22M4%2013h24%22%2F%3E%3Ccircle%20cx%3D%2223%22%20cy%3D%2219.5%22%20r%3D%221.6%22%20stroke%3D%22%23C89B5A%22%20stroke-width%3D%222.2%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"); }
.gi-recv { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C2410C%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M16%204v13%22%2F%3E%3Cpath%20d%3D%22M11%2012l5%205%205-5%22%2F%3E%3Cpath%20d%3D%22M5%2020v4a2%202%200%200%200%202%202h18a2%202%200%200%200%202-2v-4%22%20stroke%3D%22%23C89B5A%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"); }
.gi-done { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C2410C%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2216%22%20cy%3D%2216%22%20r%3D%2211%22%2F%3E%3Cpath%20d%3D%22M11%2016.5l3.5%203.5L22%2012%22%20stroke%3D%22%23C89B5A%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"); }
.gi-refund { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23C2410C%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M25%2012a10%2010%200%200%200-17.5-2%22%2F%3E%3Cpath%20d%3D%22M7%204v6h6%22%2F%3E%3Cpath%20d%3D%22M7%2020a10%2010%200%200%200%2017.5%202%22%20stroke%3D%22%23C89B5A%22%2F%3E%3Cpath%20d%3D%22M25%2028v-6h-6%22%20stroke%3D%22%23C89B5A%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"); }
.gi-badge {
  position: absolute; top: -6rpx; right: -8rpx;
  min-width: 34rpx; height: 34rpx; border-radius: 18rpx; padding: 0 8rpx;
  background: #B02A30; color: #FFFFFF; font-size: 24rpx; line-height: 34rpx; text-align: center;
}

/* 菜单 */
.menu { display: flex; align-items: center; min-height: 88rpx; padding: 0; border-bottom: 1rpx solid #F0F0F0; }
.menu:last-child { border-bottom: none; }
.menu-name { flex: 1; font-size: 30rpx; color: #3F3E3E; }
.menu-arrow { color: #8C8C8C; font-size: 30rpx; margin-left: 8rpx; } /* 非文本元素，WCAG 1.4.11 要求 ≥3:1（#8C8C8C = 3.36:1） */
.menu.disabled .menu-name { color: #BBBBBB; }

/* 备案信息（公安联网备案 / ICP） */
.filing-block { margin-top: 24rpx; display: flex; flex-direction: column; gap: 6rpx; align-items: center; }
.filing-line { font-size: 22rpx; color: #9A9A9A; text-align: center; line-height: 1.6; }

/* 技术支持署名 */
.tech-support { margin-top: 28rpx; text-align: center; font-size: 22rpx; color: #AAAAAA; }
