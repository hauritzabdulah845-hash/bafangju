<!-- 我的 · 拼多多配色（规范板推断：渐变头 + 订单宫格 + 功能菜单 + 合规声明）
     数据：/api/orders/list（订单宫格角标为真实状态计数） -->
<view class="profile">

  <!-- 渐变带：只承载头像图标，文字移到下方上浮白卡 -->
  <view class="grad-header" style="padding:40rpx 32rpx 96rpx;border-radius:0 0 32rpx 32rpx">
    <view class="hero-icon"><view class="hi hi-user"></view></view>
  </view>

  <!-- 上浮状态卡：用户信息（头像可点击更换；昵称区点击→我的券；复制ID与消息铃铛用 catchtap 隔离） -->
  <view class="card hero-card">
    <view style="display:flex;align-items:center;justify-content:center">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar"></view>
      </button>
      <view catchtap="goCoupons" style="display:flex;align-items:center;margin-left:20rpx">
        <view style="text-align:left">
          <view style="font-size: 30rpx;font-weight:600;color:#3F3E3E">{{nickname}}</view>
          <view style="margin-top:6rpx;display:flex;align-items:center" catchtap="copyId">
            <text style="font-size:22rpx;color:#666666">ID: {{userId || '登录中…'}}</text>
            <text style="font-size:20rpx;color:#8F1F26;margin-left:10rpx">复制</text>
          </view>
          <view style="margin-top:6rpx" wx:if="{{level}}">
            <text style="font-size:22rpx;color:#666666">等级 {{level.level}} · {{level.levelName}} · 有效人数 {{level.validUsers}}</text>
          </view>
        </view>
      </view>
      <view class="head-notice" catchtap="goMessages" style="margin-left:auto">
        <view class="msg-dot" wx:if="{{unread > 0}}"></view>
      </view>
    </view>
  </view>

  <view style="padding:0 24rpx 40rpx;margin-top:0">

    <!-- 订单宫格：真实状态计数 -->
    <view class="card" style="margin-top:0">
      <view class="row-between">
        <view class="t1">我的订单</view>
        <view class="t3 t-accent" bindtap="goOrders">查看全部 ›</view>
      </view>
      <view class="order-grid">
        <view class="grid-item" bindtap="goOrders" data-tab="pending">
          <view class="gi-icon gi-pay"><view class="gi-badge" wx:if="{{counts.pending}}">{{counts.pending}}</view></view>
          <text class="t3">待付款</text>
        </view>
        <view class="grid-item" bindtap="goOrders" data-tab="receiving">
          <view class="gi-icon gi-recv"><view class="gi-badge" wx:if="{{counts.receiving}}">{{counts.receiving}}</view></view>
          <text class="t3">待收货</text>
        </view>
        <view class="grid-item" bindtap="goOrders" data-tab="done">
          <view class="gi-icon gi-done"><view class="gi-badge" wx:if="{{counts.done}}">{{counts.done}}</view></view>
          <text class="t3">已完成</text>
        </view>
        <view class="grid-item" bindtap="goOrders" data-tab="all">
          <view class="gi-icon gi-refund"></view>
          <text class="t3">退款/售后</text>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="card">
      <view class="menu" bindtap="goTab" data-url="/pages/returns/returns">
        <text class="menu-name">{{menu.returns || '阶梯优惠与进度'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goPage" data-url="/pages/rebuy/rebuy">
        <text class="menu-name">{{menu.rebuy || '常买商品（一键再买）'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goPage" data-url="/pages/coupons/coupons">
        <text class="menu-name">{{menu.coupons || '我的券（联盟优惠）'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goAddress">
        <text class="menu-name">{{menu.address || '收货地址'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu {{downgrade ? 'disabled' : ''}}" bindtap="goDividend">
        <text class="menu-name">{{menu.dividend || '我的分红'}}{{downgrade ? '（维护中）' : ''}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goPage" data-url="/pages/promotion/promotion">
        <text class="menu-name">{{menu.promotion || '推广中心（邀请好友）'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goPage" data-url="/pages/withdraw/withdraw">
        <text class="menu-name">{{menu.withdraw || '提现'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <!-- 历史广告奖励余额兑付入口（合规整改后不再新增发放，仅保留存量兑付） -->
      <view class="menu" bindtap="goPage" data-url="/pages/cash/cash">
        <text class="menu-name">{{menu.cash || '奖励余额'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goMessages">
        <text class="menu-name">{{menu.messages || '消息中心'}}</text>
        <view class="gi-badge" wx:if="{{unread > 0}}">{{unread}}</view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goPage" data-url="/pages/tasks/tasks">
        <text class="menu-name">{{menu.tasks || '签到与任务'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goPage" data-url="/pages/rules/rules">
        <text class="menu-name">{{menu.rules || '规则说明'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goAgreement" data-type="privacy">
        <text class="menu-name">{{menu.privacy || '隐私政策'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goAgreement" data-type="terms">
        <text class="menu-name">{{menu.terms || '用户协议'}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 商家服务（单小程序双角色：商家工作台在分包 subpkg-merchant，账号密码登录，与顾客身份并存） -->
    <view class="card">
      <view class="menu" bindtap="goMerchant">
        <text class="menu-name">{{isMerchant ? '商家工作台（已登录）' : '商家工作台'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goPage" data-url="/subpkg-merchant/pages/entry/entry">
        <text class="menu-name">商家入驻申请</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="notice">{{ct['profile.compliance'] || '合规声明：本平台不承诺全额返、不承诺保本、不形成资金池；阶梯优惠已算在商品售价里；排队分红只分平台真实利润；贡献值不能换现金。'}}</view>

    <!-- 备案信息（公安联网备案 / ICP）：后台未配置时整块隐藏 -->
    <view class="filing-block" wx:if="{{filing.icp || filing.police}}">
      <view class="filing-line" wx:if="{{filing.icp}}" bindtap="copyFiling" data-no="{{filing.icp.no}}">ICP备案号：{{filing.icp.no}}</view>
      <view class="filing-line" wx:if="{{filing.police}}" bindtap="copyFiling" data-no="{{filing.police.no}}">{{filing.police.no}}</view>
    </view>

    <!-- 技术支持署名 -->
    <view class="tech-support">益阳智讯网络科技有限公司提供技术支持</view>
  </view>
</view>
