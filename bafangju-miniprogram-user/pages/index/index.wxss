.pull { text-align: center; font-size: 20rpx; color: #CCCCCC; padding: 8rpx 0 4rpx; }

.empty { text-align: center; padding: 60rpx 0; }

/* ---------- 通用按钮（复购卡 foot） ---------- */
.btn-primary {
  background: linear-gradient(90deg, #C9525A, #B02A30);
  color: #FFFFFF; font-size: 30rpx; font-weight: 500;
  border-radius: 44rpx; padding: 20rpx 48rpx; text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(176, 42, 48, 0.22);
}
.btn-sm { font-size: 24rpx; padding: 12rpx 32rpx; }

/* ---------- 商品无图占位色轮换（低饱和 6 色） ---------- */
.tone-1 { background: linear-gradient(160deg, #F7E4E2, #EFCFCC); }
.tone-2 { background: linear-gradient(160deg, #F6F1E7, #EBE1D0); }
.tone-3 { background: linear-gradient(160deg, #F4F4F4, #E9E9E9); }
.tone-4 { background: linear-gradient(160deg, #FFF3D9, #FFE7B8); }
.tone-5 { background: linear-gradient(160deg, #F7EDF0, #EEDFE4); }
.tone-6 { background: linear-gradient(160deg, #EFE3E2, #E2D1CF); }

/* ---------- 网络诊断按钮（错误态下出现；仅开发环境可见） ---------- */
.diag-btn {
  display: inline-block; margin-top: 16rpx; padding: 10rpx 28rpx;
  background: #FFF; border: 2rpx solid #B02A30; border-radius: 999rpx;
  color: #8F1F26; font-size: 28rpx; font-weight: 500;
}
