/* 自定义 tabBar 为 fixed 定位，不自动占位，需自行留出底部高度（116rpx + 安全区） */
page { padding-bottom: calc(124rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 首页 · 对齐 UI 全案 v4（枣红 V3 / redesign-20261102/home.html）：
   头部（一行式）→ 营销条咬合 → 轮播圆角卡 → 金刚区 → 复购大卡（阶梯 chip）
   → 附近商家横图卡 → 为你推荐单列流。头部是全页唯一深色块。 */

/* ---------- 头部：纯枣红 + 20rpx 底部圆角 ---------- */
.home { min-height: 100vh; }
.home-head {
  background: #B02A30;
  border-radius: 0 0 40rpx 40rpx;
  padding: 8rpx 0 44rpx;
}
.hdr-row { display: flex; align-items: center; gap: 20rpx; padding: 0 32rpx; height: 68rpx; }
.loc { display: flex; align-items: center; flex: 0 0 auto; }
.loc-name { font-size: 30rpx; font-weight: 700; color: #FFFFFF; }
.loc-arrow {
  width: 0; height: 0; margin-left: 8rpx;
  border-left: 10rpx solid transparent; border-right: 10rpx solid transparent;
  border-top: 12rpx solid rgba(255,255,255,.9);
}
.search-box {
  flex: 1; min-width: 0; height: 68rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.96);
  display: flex; align-items: center; gap: 12rpx; padding: 0 24rpx;
}
.search-icon {
  width: 26rpx; height: 26rpx; flex-shrink: 0;
  background: url("data:image/svg+xml;base64,") no-repeat center / contain;
}
.search-input { flex: 1; min-width: 0; font-size: 24rpx; color: #1A1A1A; }
.search-ph { color: #999999; }
.search-clear { font-size: 24rpx; color: #8F1F26; font-weight: 500; flex-shrink: 0; }
.head-bell {
  width: 52rpx; height: 52rpx; flex: 0 0 auto; position: relative;
  background: url("data:image/svg+xml;base64,") no-repeat center / contain;
}
/* 未读消息角标：铃铛右上红点，>99 显示 99+ */
.bell-dot {
  position: absolute; top: -8rpx; right: -12rpx;
  min-width: 30rpx; height: 30rpx; padding: 0 8rpx; box-sizing: border-box;
  border-radius: 999rpx; background: #FF3B30;
  color: #FFFFFF; font-size: 18rpx; line-height: 30rpx; text-align: center;
  border: 2rpx solid #B02A30;
}

/* ---------- 营销条：浅金券条，-32rpx 咬合头部 ---------- */
.promo {
  margin: -32rpx 24rpx 0; position: relative; z-index: 2;
  height: 144rpx; border-radius: 32rpx;
  background: linear-gradient(96deg, #F8EBD4 0%, #EFD3A2 100%);
  box-shadow: 0 10rpx 26rpx rgba(176, 42, 48, 0.12);
  padding: 0 32rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.promo-t { font-size: 32rpx; font-weight: 700; color: #8F1F26; letter-spacing: 0.5rpx; }
.promo-s { font-size: 22rpx; color: rgba(143,31,38,.64); margin-top: 8rpx; }
.promo-link {
  flex: 0 0 auto; height: 56rpx; padding: 0 24rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(143,31,38,.30);
  color: #8F1F26; font-size: 22rpx; font-weight: 500;
  display: flex; align-items: center; white-space: nowrap;
}

/* ---------- 活动轮播：圆角卡（业务保留广告位，视觉降噪） ---------- */
/* banner 在头部内部：通栏无圆角，与红区连成一体（tone-1 渐变左端 = 头部红，无缝衔接） */
.hero { position: relative; margin: 20rpx 0 0; }
.hero-swiper { height: 300rpx; border-radius: 0; overflow: hidden; }
.slide { position: relative; width: 100%; height: 100%; overflow: hidden;
  display: flex; flex-direction: column; justify-content: center; }
.slide-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.slide-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.slide-bg.tone-1 { background: linear-gradient(120deg, #B02A30, #8F1F26); }
.slide-bg.tone-2 { background: linear-gradient(120deg, #C9525A, #B02A30); }
.slide-bg.tone-3 { background: linear-gradient(120deg, #8F1F26, #621418); }
.slide-bg.tone-4 { background: linear-gradient(120deg, #A8383E, #7E1C22); }
.slide-emoji { position: absolute; right: 14rpx; bottom: -14rpx; font-size: 140rpx; line-height: 1; opacity: .26; }
.slide-shade {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(0,0,0,.42) 0%, rgba(0,0,0,.24) 40%, rgba(0,0,0,.06) 72%, rgba(0,0,0,0) 100%);
}
.slide-shade.shade-bottom { background: linear-gradient(180deg, rgba(0,0,0,0) 58%, rgba(0,0,0,.3) 100%); }
.slide-body { position: relative; padding: 0 0 0 28rpx; }
.slide-title { font-size: 34rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 1rpx; line-height: 1.26; }
.slide-tags { display: flex; flex-wrap: wrap; align-items: center; margin-top: 16rpx; padding-right: 24rpx; }
.slide-sub {
  /* 原为品牌红实底，但轮播底本来就是枣红，红底压红底等于没有底色；
     改半透明白描边胶囊，与右侧白实底按钮形成主次 */
  background: rgba(255,255,255,.16); color: #FFFFFF;
  border: 1rpx solid rgba(255,255,255,.44);
  font-size: 22rpx; font-weight: 500; border-radius: 999rpx; padding: 8rpx 20rpx;
}
.slide-btn {
  margin-left: 12rpx; background: rgba(255,255,255,.94); color: #8F1F26;
  font-size: 24rpx; font-weight: 600; border-radius: 999rpx; padding: 8rpx 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.10);
}
.slide-from {
  position: absolute; right: 20rpx; bottom: 20rpx; max-width: 38%;
  background: rgba(0,0,0,.32); color: #FFFFFF;
  font-size: 24rpx; border-radius: 999rpx; padding: 6rpx 18rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.s-dots { position: absolute; left: 0; right: 0; bottom: 14rpx; display: flex; justify-content: center; align-items: center; }
.s-dot {
  width: 14rpx; height: 14rpx; margin: 0 7rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.45); box-shadow: 0 1rpx 4rpx rgba(0,0,0,.18);
  transition: width .2s ease, background .2s ease;
}
.s-dot.on { width: 40rpx; background: #FFFFFF; }

/* ---------- 金刚区：通栏白底 + 浅品牌底圆 + 品牌色图标 ---------- */
.wrap { padding-bottom: 40rpx; }
.kk-card { margin: 20rpx 0 0; background: #FFFFFF; border-radius: 0; padding: 28rpx 8rpx 8rpx; }
.kk-grid { display: flex; flex-wrap: wrap; }
.kk-item { width: 20%; display: flex; flex-direction: column; align-items: center; margin-bottom: 24rpx; }
.kk-icon {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; overflow: hidden;
}
/* 底圆暖色三拍轮换（js bg = i%3+1）：浅红 / 浅沙金 / 米灰，均取自红金体系的低饱和端 */
.kk-icon.bg-1 { background: #FAECEC; }
.kk-icon.bg-2 { background: #F6EDD8; }
.kk-icon.bg-3 { background: #F5F0E9; }
/* 定制图占比 86%（6/7），四周留出呼吸空隙，不顶到圆边 */
.kk-img { width: 72rpx; height: 72rpx; display: block; }
.kk-name { font-size: 22rpx; color: #666666; margin-top: 10rpx; }

/* ---------- 金刚区线性图标（红主金辅双色，描边 1.8；底圆暖色轮换见 .bg-1~3。后台 iconImage 仅对无预设图标的类目兜底） ---------- */
