@import "design-tokens.wxss";

/* ============================================================
   八方聚用户端 · 设计系统 V3.0
   ----------------------------------------------------------
   共享层：design-tokens.wxss（文字层级 / 卡片 / 布局 / 价格 / 合规提示 …）
   本文件只写**用户端差异项**。改共享样式请改 design-tokens.wxss
   （真源在 bafangju-design-tokens/，三份内容必须逐字节一致）。

   与 UI 重设计稿 redesign-20261102/（规范页 spec.html + handoff 令牌表）一致
   色板：品牌枣红 #B02A30 / 券金 #B7791F（仅营销条、促销标签）/ 奖励金 #996300
   渐变：#C9525A → #B02A30（仅用于按钮、主 CTA；头部统一纯枣红）
   原则：价格即视觉锤；枣红只给价格与主 CTA，金只给营销与奖励；密度优先（白卡 + 12px 圆角）

   可读性（WCAG 2.1 AA）：
   品牌枣红 #B02A30 在白底上 6.52:1（AA 小字达标）。需要更强对比的浅底文字
   用深枣红 #8F1F26（白底 8.78:1 / #FAF0F0 上 7.85:1）。
   ============================================================ */

/* ---------- 用户端差异：页面底色（与令牌默认同值，显式声明便于查阅） ---------- */
page { --page-bg: #F7F8FA; }

/* ---------- 用户端差异：色底上的文字（消息/规则页标题） ---------- */
.t-gold { color: #996300; }   /* 金色文字版 */
.t-white { color: #FFFFFF; }

/* ---------- 价格排版（用户端专属） ---------- */
.price-row { display: flex; align-items: baseline; }
.price-num.sm { font-size: 42rpx; }
.price-origin { font-size: 28rpx; color: #666666; margin-left: 12rpx; text-decoration: line-through; }
.price-unit { font-size: 28rpx; color: #666666; margin-left: 8rpx; }

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(90deg, #C9525A, #B02A30);
  color: #FFFFFF; font-size: 30rpx; font-weight: 500;
  border-radius: 44rpx; padding: 20rpx 48rpx; text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(176, 42, 48, 0.22);
}
.btn-primary.disabled { background: #F5CFCB; box-shadow: none; color: #FFFFFF; }
.btn-outline {
  background: #FFFFFF; color: #8F1F26; font-size: 28rpx; font-weight: 500;
  border: 1rpx solid #B02A30; border-radius: 44rpx; padding: 18rpx 40rpx; text-align: center;
}
.btn-ghost {
  background: #FFFFFF; color: #666666; font-size: 28rpx;
  border: 1rpx solid #DDDDDD; border-radius: 44rpx; padding: 18rpx 40rpx; text-align: center;
}
.btn-sm { font-size: 28rpx; padding: 16rpx 28rpx; border-radius: 36rpx; }
.btn-block { display: block; }

/* ---------- 促销标签 ---------- */
.tag { display: inline-block; font-size: 24rpx; border-radius: 8rpx; padding: 6rpx 14rpx; margin-right: 12rpx; vertical-align: middle; }
.tag-promo { background: #FAF0F0; color: #8F1F26; }      /* 第 n 单专享 */
.tag-orange { background: #FAF0F0; color: #8F1F26; }     /* 差 1 单收口 */
.tag-gold { background: #FFF7E6; color: #996300; }       /* 让利 / 奖励金 */
.tag-free { background: #B7791F; color: #5C3D00; font-weight: 600; } /* 免单达成（旧模型遗留 FREE 单展示用） */
.tag-green { background: #E8F9EF; color: #067F43; }
.tag-gray { background: #F2F2F2; color: #666666; }

/* ---------- 阶梯表（核心组件） ----------
   状态语言统一：past=已走过的步（浅红）/ next=下一单（红渐变，最强视觉）；
   让利段（尾段 4 单）以 .lc-discount 折扣角标标注，无免单终点 */
.ladder { display: flex; gap: 12rpx; position: relative; }
.ladder::before { /* 节点连接线：从格子间隙穿过，强化阶梯进程感（单行模式） */
  content: ''; position: absolute; left: 7%; right: 7%; top: 50%; height: 2rpx;
  background: #F0F0F0; z-index: 0;
}
/* 多行模式：格数 > 5 时自动折行（每格宽由 JS 计算 flex-basis 下发），连接线失去意义，关闭 */
.ladder.wrap { flex-wrap: wrap; row-gap: 20rpx; }
.ladder.wrap::before { display: none; }
.ladder-cell {
  flex: 1; min-width: 0; position: relative; z-index: 1;
  background: #F7F7F7; border-radius: 14rpx;
  padding: 16rpx 4rpx 12rpx; text-align: center;
}
/* 节省额角标：挂在下一单格顶部，Absolute 定位突出格子上沿 */
.lc-badge {
  position: absolute; top: -16rpx; left: 50%; transform: translateX(-50%);
  background: #B02A30; color: #FFFFFF; font-size: 22rpx; font-weight: 600;
  padding: 2rpx 12rpx; border-radius: 999rpx; white-space: nowrap; line-height: 1.4; z-index: 2;
}
.ladder-cell .lc-price {
  font-size: 28rpx; font-weight: 700; color: #3F3E3E; line-height: 1.2;
  white-space: nowrap; font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}
.ladder-cell .lc-label { font-size: 24rpx; color: #666666; margin-top: 6rpx; line-height: 1.2; white-space: nowrap; }
/* 已走过的步 */
.ladder-cell.past { background: #FAF0F0; }
.ladder-cell.past .lc-price { color: #8F1F26; }
.ladder-cell.past .lc-label { color: #B23B34; }
/* 下一单：用户下一个动作的目标，全组件最强视觉（含呼吸光晕） */
.ladder-cell.next {
  background: linear-gradient(180deg, #C9525A, #B02A30);
  animation: lcPulse 2s ease-in-out infinite;
}
@keyframes lcPulse {
  0%, 100% { box-shadow: 0 6rpx 16rpx rgba(176, 42, 48, 0.22); }
  50% { box-shadow: 0 6rpx 26rpx rgba(176, 42, 48, 0.48); }
}
.ladder-cell.next .lc-price { color: #FFFFFF; }
.ladder-cell.next .lc-label { color: rgba(255, 255, 255, 0.9); }
/* 让利段折扣标注（尾段 4 单：省10%/20%/30%/40%） */
.ladder-cell .lc-discount { font-size: 22rpx; color: #8F1F26; margin-top: 4rpx; line-height: 1.2; white-space: nowrap; }
/* 免单终点（旧模型遗留样式，新模型不再产出 free 态） */
.ladder-cell.free { background: linear-gradient(180deg, #FFC940, #B7791F); }
.ladder-cell.free .lc-price { color: #5C3D00; }
.ladder-cell.free .lc-label { color: rgba(92, 61, 0, 0.75); }
.ladder-cell.free .lc-badge { background: #5C3D00; }

/* ---------- 进度条 ---------- */
.progress { height: 12rpx; background: #F0F0F0; border-radius: 6rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #C9525A, #B02A30); border-radius: 6rpx; }
.progress-fill.gold { background: linear-gradient(90deg, #FFC940, #B7791F); }
.progress-fill.green { background: #07C160; }

/* ---------- 合规提示（链接态为用户端专属） ---------- */
.notice-link { color: #8F1F26; text-decoration: underline; }

/* ---------- 兼容层：存量页面类名（订单/消息/任务/我的/规则/推广/团队/提现/地址） ---------- */
.price { color: #B02A30; font-weight: 700; }


/* ============================================================
   共享功能图标库（ICON TOKENS）
   ----------------------------------------------------------
   替代页面头部散落的 emoji：emoji 在 iOS/Android/微信内置渲染各异，
   且彩色面性与本系统的红金线性图标语言冲突。
   统一基线：24×24 网格 / stroke-width 1.8 / round cap&join / fill none
   渐变红头上的图标固定白色；浅底场景请给容器加深色底再用白色图标。
   用法：<view class="hero-icon"><view class="hi hi-bag"></view></view>
   ============================================================ */
