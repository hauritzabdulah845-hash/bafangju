@import '../../merchant-base.wxss';

.sum-row { display: flex; justify-content: space-between; padding: 10rpx 0 20rpx; }
.wd-input {
  background: #f5f6f8; border-radius: 12rpx; padding: 24rpx;
  margin-bottom: 20rpx; text-align: center; font-size: 34rpx;
}
.sec-title { font-weight: 700; margin-bottom: 12rpx; }
.wd-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.wd-item:last-child { border-bottom: none; }
.btn-mini {
  background: #B02A30; color: #fff; font-size: 28rpx;
  padding: 10rpx 20rpx; border-radius: 8rpx;
}
.empty { text-align: center; padding: 40rpx 0; }
