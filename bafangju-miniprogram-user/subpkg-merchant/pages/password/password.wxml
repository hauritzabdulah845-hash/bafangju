<!-- 商家端 · 修改登录密码 -->
<view class="pwd-page">
  <view class="card">
    <view class="t1">修改登录密码</view>
    <view class="t-weak" style="margin-top:8rpx">首次登录使用初始密码时，建议立即修改为个人密码。</view>
    <view class="pwd-field" style="margin-top:24rpx">
      <input class="ipt" password="{{!showOld}}" placeholder="原密码" value="{{oldPassword}}" data-k="oldPassword" bindinput="onInput" />
      <view class="eye" data-k="showOld" bindtap="toggleEye" aria-label="{{showOld ? '隐藏密码' : '显示密码'}}"><view class="eye-ico {{showOld ? 'on' : 'off'}}"></view></view>
    </view>
    <view class="pwd-field" style="margin-top:14rpx">
      <input class="ipt" password="{{!showNew}}" placeholder="新密码（至少 8 位）" value="{{newPassword}}" data-k="newPassword" bindinput="onInput" />
      <view class="eye" data-k="showNew" bindtap="toggleEye" aria-label="{{showNew ? '隐藏密码' : '显示密码'}}"><view class="eye-ico {{showNew ? 'on' : 'off'}}"></view></view>
    </view>
    <view class="pwd-field" style="margin-top:14rpx">
      <input class="ipt" password="{{!showConfirm}}" placeholder="确认新密码" value="{{confirmPassword}}" data-k="confirmPassword" bindinput="onInput" />
      <view class="eye" data-k="showConfirm" bindtap="toggleEye" aria-label="{{showConfirm ? '隐藏密码' : '显示密码'}}"><view class="eye-ico {{showConfirm ? 'on' : 'off'}}"></view></view>
    </view>
    <view class="btn" style="margin-top:28rpx" bindtap="submit">{{submitting ? '提交中…' : '确认修改'}}</view>
    <view class="t-weak" style="margin-top:16rpx">修改成功后当前登录会失效，请用新密码重新登录。</view>
  </view>
</view>
