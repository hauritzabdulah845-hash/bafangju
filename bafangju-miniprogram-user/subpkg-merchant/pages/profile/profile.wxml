<!-- 商家端 · 我的（tabBar 第 4 项，对应设计稿底部导航）
     结构：渐变头部（店铺信息）→ 资产卡（真实余额）→ 功能菜单 → 规则说明 → 退出登录 -->
<view class="mp">

  <!-- 渐变头部：店铺信息 -->
  <view class="grad-header" style="padding:40rpx 32rpx 64rpx;border-radius:0 0 32rpx 32rpx">
    <view class="row">
      <view class="shop-avatar"></view>
      <view style="flex:1;margin-left:24rpx">
        <view style="font-size: 30rpx;font-weight:600;color:#FFFFFF">{{merchantName || '商家'}}</view>
        <view style="font-size:22rpx;color:rgba(255,255,255,.85);margin-top:8rpx">商家 ID：{{merchantId || '—'}}</view>
      </view>
      <view class="shop-open">营业中</view>
    </view>
  </view>

  <view style="padding:0 24rpx 40rpx;margin-top:-40rpx">

    <!-- 资产卡：真实余额 -->
    <view class="card" style="margin-top:0">
      <view class="row-between">
        <view class="t1">我的资产</view>
        <view class="tag {{withdrawEnabled ? 'green' : 'gray'}}">{{withdrawEnabled ? '提现已开通' : '提现未开通'}}</view>
      </view>
      <view class="row" style="align-items:baseline;margin-top:12rpx">
        <text class="price-symbol">¥</text><text class="price-num">{{balanceYuan}}</text>
        <text class="t-weak" style="margin-left:16rpx">可提现余额</text>
      </view>
      <view class="row-between" style="margin-top:16rpx">
        <text class="t-weak">待结算（售后保障期内）¥{{frozenYuan}}</text>
        <view class="btn btn-sm" bindtap="goWithdraw">去提现</view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="card">
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/orders/orders">
        <text class="menu-name">发货与核销</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/coupons/coupons">
        <text class="menu-name">我的券</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/shop/shop">
        <text class="menu-name">门店主页</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/fee-bills/fee-bills">
        <text class="menu-name">核销对账</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/products/products">
        <text class="menu-name">我的商品</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/ads/ads">
        <text class="menu-name">广告位</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/withdraw/withdraw">
        <text class="menu-name">提现</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/entry/entry">
        <text class="menu-name">入驻资料</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="go" data-url="/subpkg-merchant/pages/password/password">
        <text class="menu-name">修改密码</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goAgreement" data-type="privacy">
        <text class="menu-name">隐私政策</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu" bindtap="goAgreement" data-type="terms">
        <text class="menu-name">合作协议</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 规则说明（静态） -->
    <view class="card">
      <view class="t1">规则说明</view>
      <view class="t3" style="margin-top:12rpx;line-height:1.8">1. 券核销：顾客到店出示券码，核销成功后自动记收益；同一张券只认第一次核销，过期或已核销的券不能再核销。</view>
      <view class="t3" style="margin-top:8rpx;line-height:1.8">2. 广告位：广告费由平台单独保管，不计入你的货款收益；投放后如需退款，请联系平台运营。</view>
      <view class="t3" style="margin-top:8rpx;line-height:1.8">3. 提现：可提现余额转到你绑定的微信零钱，到账后需在「提现」页点「确认收款」；提现功能需平台审核开通（入驻满 90 天）。</view>
    </view>

    <view class="btn-plain btn-block" bindtap="logout">退出登录</view>

    <view class="notice">平台不承诺保本、不承诺全额返；你的收益只按真实核销记录和广告投放记录结算。</view>
  </view>
</view>

<!-- 商家工作台底栏（分包组件，非系统 tabBar） -->
<mtab selected="{{3}}" />
