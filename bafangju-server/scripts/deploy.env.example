# 八方聚生产环境变量模板
# 使用方式：sudo cp scripts/deploy.env.example /etc/bafangju.env && sudo nano /etc/bafangju.env
# 权限：chmod 600 /etc/bafangju.env（含明文口令与密钥，不得入库、不得 chmod 644）

# ---- 运行 ----
NODE_ENV=production
PORT=3000
# 只监听本机，由 nginx 反代对外（3000 不对公网开放）
HOST=127.0.0.1

# ---- 域名（备案通过后与 nginx / 小程序合法域名保持一致）----
DOMAIN=bfjzs.com

# ---- 管理后台（密码须长度大于 10 位且同时含字母、数字，否则服务拒绝启动）----
# 密码含空格、$、! 等特殊字符时，请用单引号包裹整行值，例如：ADMIN_PASSWORD='Abc 123$Xy'
ADMIN_USER=bafangju
ADMIN_PASSWORD=请改成你自己的强口令A1b2C3

# ---- 微信小程序（AppSecret 只在服务器保存，切勿外泄）----
WX_APPID=wxa8811b4cc88f9857
WX_SECRET=

# ---- 商家端小程序 ----
# 当前两个端共用同一个小程序（wxa8811b4cc88f9857），因此这里填与上面相同的 AppID / AppSecret；
# 若以后拆成独立小程序，改成商家端自己的 appid/secret（用错会 40029）
WX_MERCHANT_APPID=wxa8811b4cc88f9857
WX_MERCHANT_SECRET=

# ---- 反向代理：nginx 后必配 1，否则上传限流按 127.0.0.1 累计 ---- 
TRUST_PROXY=1

# ---- 数据路径（放在数据盘并纳入备份；默认在 /opt/bafangju/data）----
BAFANGJU_DB_PATH=/opt/bafangju/data/bafangju.db
BAFANGJU_UPLOAD_DIR=/opt/bafangju/data/uploads
BAFANGJU_UPLOAD_PRIVATE_DIR=/opt/bafangju/data/uploads-private

# ---- 微信支付（材料到位后再填，留空则走 mock 通道）----
# 证书放置与权限：sudo bash scripts/setup-wxpay-certs.sh --src /root/wxpay
# WX_MCHID=1900000001
# WX_MERCHANT_SERIAL=（商户 API 证书序列号，脚本可自动填）
# WX_PRIVATE_KEY=/opt/bafangju/certs/apiclient_key.pem
# WX_APIV3_KEY=（32 位，商户平台 → API 安全 → APIv3 密钥）
# WX_PLATFORM_CERT=/opt/bafangju/certs/wechatpay_platform.pem（或 wechatpay_pub.pem）
# WX_PLATFORM_SERIAL=（平台证书序列号；公钥模式填「公钥ID」。配置后回调头会强校验）
# WX_NOTIFY_URL=https://bfjzs.com/api/payment/notify-wx
# WX_REFUND_NOTIFY_URL=https://bfjzs.com/api/payment/refund-notify
# PAY_MODE=live（不填按材料自动判定；生产环境必须是 live）
