# ============================================================
# 八方聚 · 本地联调环境变量（复制为 .env.local 后填写）
#   copy .env.local.example .env.local
#   powershell -ExecutionPolicy Bypass -File scripts\start-local.ps1
#
# 安全：.env.local 与 certs/ 已被 .gitignore 忽略，切勿提交或截图外发
# ============================================================

# ---- 基础 ----
NODE_ENV=development
PORT=3000
# 本地管理员初始口令（仅本地，生产用 /etc/bafangju.env 的强口令）
ADMIN_PASSWORD=LocalDev123456

# ---- 支付通道 ----
# mock：不真扣款，订单模拟支付成功，适合先跑通业务
# live ：真扣款，必须配齐下面的商户材料
PAY_MODE=mock

# ---- 微信支付商户材料（PAY_MODE=live 时必填）----
# 商户号
WX_MCHID=
# 小程序 AppID（需与商户号完成关联）
WX_APPID=
# 商户 API 证书序列号（运行 setup-wxpay-certs.ps1 会自动打印）
WX_MERCHANT_SERIAL=
# 商户 API 私钥路径（本地 certs/apiclient_key.pem）
WX_PRIVATE_KEY=certs/apiclient_key.pem
# APIv3 密钥，必须 32 位（商户平台 → API 安全 → APIv3 密钥）
WX_APIV3_KEY=
# 平台证书或微信支付公钥路径
WX_PLATFORM_CERT=certs/wechatpay_platform.pem
# 平台证书序列号；公钥模式填「公钥ID」。配置后回调头会强校验
WX_PLATFORM_SERIAL=

# ---- 回调地址（本地必须用内网穿透，localhost 收不到微信回调）----
# 例：https://xxxx.ngrok-free.app/api/payment/notify-wx
WX_NOTIFY_URL=
WX_REFUND_NOTIFY_URL=
